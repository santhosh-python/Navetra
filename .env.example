# Copy this file to .env.local and fill in values there. Never commit real values.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
#
# Base URL of the future Navetra API (planned Python service, not built yet).
# Leave it EMPTY to use the built-in synthetic demo data (the default).
# When set, services call the planned endpoints listed in src/services/inventoryService.ts.
# Use your own deployed or local API address here, for example:
#   VITE_API_BASE_URL=https://api.example.org/navetra
VITE_API_BASE_URL=
