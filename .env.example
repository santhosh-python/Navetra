# Copy this file to .env.local and fill in values there. Never commit real values.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
#
# Backend API used by the browser inventory service. Leave empty to use the
# separate synthetic browser demo; this does not connect the research page.
VITE_API_BASE_URL=
# FastAPI historical research service, for example http://127.0.0.1:8000.
# For a remote browser, use the server's reachable address instead of
# 127.0.0.1, which points to the browser's own computer.
VITE_RESEARCH_API_BASE_URL=
