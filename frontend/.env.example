# Frontend requests use this base path. Keep it relative when the deployed frontend
# and backend share an origin; Vite proxies /api during local development.
VITE_API_BASE_URL=/api

# Optional local Python API address used only by the Vite development proxy.
# The browser itself continues to call the relative /api path.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
